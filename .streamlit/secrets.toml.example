# ============================================================
# PaddyCare - local secrets template
# ============================================================
#
# Copy this file to  .streamlit/secrets.toml  and replace the
# placeholder values with your own credentials.
#
#   .streamlit/secrets.toml  is git-ignored and must NEVER be
#   committed. Never paste real credentials into this example
#   file, into a commit, or into an issue/PR.
#
# Only GEMINI_API_KEY is required to run PaddyCare.
# See README.md -> Configuration for details.
# ============================================================

# Required - Google Gemini API key (Google AI Studio)
GEMINI_API_KEY = "your_gemini_api_key_here"

# ------------------------------------------------------------
# Optional / reserved for future messaging integration.
# PaddyCare does not use these in the current UI; the helpers in
# app.py are inactive unless these values are present.
# ------------------------------------------------------------
# TWILIO_ACCOUNT_SID = "your_twilio_account_sid"
# TWILIO_AUTH_TOKEN = "your_twilio_auth_token"
# TWILIO_WHATSAPP_FROM = "your_twilio_whatsapp_sender"
# TWILIO_CONTENT_SID = "your_twilio_content_template_sid"
